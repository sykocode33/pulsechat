# ──────────────────────────────────────
# PulseChat Environment Configuration
# ──────────────────────────────────────

# App
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://pulsechat:pulsechat_secret@localhost:5432/pulsechat?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=your-access-secret-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-this-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# MinIO / S3 Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=pulsechat_minio
MINIO_SECRET_KEY=pulsechat_minio_secret
MINIO_BUCKET=pulsechat-uploads
MINIO_USE_SSL=false

# SMTP (for OTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM=noreply@pulsechat.com

# Coturn (TURN/STUN)
TURN_URL=turn:your-domain:3478
TURN_USERNAME=pulsechat
TURN_PASSWORD=turn_secret

# Domain (Production)
DOMAIN=your-domain.com
